{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/insight.html",
      "destination": "/insight",
      "permanent": true
    },
    {
      "source": "/renewal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renewal/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renewal/portfolio",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/renewal/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/renewal/work.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/#why",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#why",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/insight/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/insight/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/renewal/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/jyng033/overclo@main/public/renewal/:path*"
    },
    {
      "source": "/image_overclo/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/jyng033/overclo@main/public/image_overclo/:path*"
    },
    {
      "source": "/insight",
      "destination": "https://overclo-insight.pages.dev/"
    },
    {
      "source": "/insight/:file.:ext",
      "destination": "https://overclo-insight.pages.dev/:file.:ext"
    },
    {
      "source": "/insight/:dir/:file.:ext",
      "destination": "https://overclo-insight.pages.dev/:dir/:file.:ext"
    },
    {
      "source": "/insight/:path*",
      "destination": "https://overclo-insight.pages.dev/:path*/"
    }
  ]
}
