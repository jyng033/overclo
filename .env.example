# Notion integration token
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: target page title in Notion
NOTION_PAGE_TITLE=홈페이지 제작광고 가이드

# Optional: source markdown path
NOTION_MD_PATH=홈페이지제작_광고_전용_가이드_2025_2026.md

# Supabase public client values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets. Never expose these in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# App URLs
NEXT_PUBLIC_SITE_URL=https://www.overclo.com
ADMIN_SITE_URL=https://admin.overclo.com
